# TMDB API Configuration
# 1. Go to https://www.themoviedb.org/ and create an account
# 2. Navigate to Settings > API
# 3. Click "Create" under API Key (v3 auth)
# 4. Copy the "API Read Access Token" (NOT the API Key)
# 5. Paste it below and rename this file to .env
BASE_URL=https://api.themoviedb.org
TMDB_TOKEN=YOUR_TMDB_API_READ_ACCESS_TOKEN_HERE
